extends layout

mixin btn-images(name)
  svg.f-btn-image-off: use(href="/images/sprite.svg#btn_" + name)
  svg.f-btn-image-on: use(href="/images/sprite.svg#btn_" + name + "_on")

block content
  .f-bg
  .f-container
    img.f-header(src='images/header.svg')

    canvas#f-canvas(width='700' height='700')

    .f-controls
      .f-btn.f-btn-color.f-btn--active(data-value='red', data-type='color')
        +btn-images("red")

      each val in ["green", "pink", "spray"]
        .f-btn.f-btn-color(data-value=val, data-type='color')
          +btn-images(val)

      .f-btn.f-btn-size(data-value=2, data-type='size')
        +btn-images("1")
      .f-btn.f-btn-size.f-btn--active(data-value=4, data-type='size')
        +btn-images("2")
      .f-btn.f-btn-size(data-value=8, data-type='size')
        +btn-images("3")

    if projection
      img.f-qrcode(src='images/qrcode.svg')

  script(src='/javascripts/application.js?v2026.2')
